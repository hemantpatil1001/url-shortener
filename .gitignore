# Ignore build output directories
target/
.mvn/

# Ignore IDE-specific files
*.iml
.idea/
.vscode/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore logs and temporary files
*.log
*.tmp
*.swp

# Ignore compiled files
*.class

# Ignore dependency directories
node_modules/
vendor/

# Allow only relevant files
!.gitignore
!src/
!pom.xml
!README.md
!*.java